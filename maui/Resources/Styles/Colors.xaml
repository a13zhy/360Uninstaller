<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="AppBackgroundColor">#F5F6F8</Color>
    <Color x:Key="AppCardColor">#FFFFFF</Color>
    <Color x:Key="AppBorderColor">#E2E5EA</Color>
    <Color x:Key="AppTextColor">#1B2430</Color>
    <Color x:Key="AppTextSubColor">#5A6572</Color>
    <Color x:Key="AppAccentColor">#2B7CF6</Color>
    <Color x:Key="AppSuccessColor">#2E9E5B</Color>
    <Color x:Key="AppDangerColor">#D84A4A</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F6F8" />
    <SolidColorBrush x:Key="AppCardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#E2E5EA" />
    <SolidColorBrush x:Key="AppTextBrush" Color="#1B2430" />
    <SolidColorBrush x:Key="AppTextSubBrush" Color="#5A6572" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="#2B7CF6" />
    <SolidColorBrush x:Key="AppSuccessBrush" Color="#2E9E5B" />
    <SolidColorBrush x:Key="AppDangerBrush" Color="#D84A4A" />

    <Color x:Key="Primary">#2B7CF6</Color>
    <Color x:Key="PrimaryDark">#1B5FC4</Color>
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray900">#212121</Color>

    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
</ResourceDictionary>
